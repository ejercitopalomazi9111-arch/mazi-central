# La carpeta que arma `node build.mjs`. Se genera en cada despliegue; tenerla
# en el repo sólo duplicaría 69 MB y garantizaría que un día esté vieja.
dist/
node_modules/
.wrangler/
.DS_Store

# Llaves. NUNCA al repo: es público y con escaneo — el proveedor las revoca solo.
.env
.env.local
*.env

# Caché de Python: la genera importlib al cargar oir.py en las pruebas.
__pycache__/
*.pyc

# Intermedio del taller de Toydarians: `armar.py` lo regenera y lo que se
# publica es `toydarians/index.html`. Commitearlo duplicaría el estado.
toydarians/taller/sitio.html

# Los bancos de trabajo de los subagentes. Cada uno es un `git worktree` con
# una copia ENTERA del repo: commitearlo metería el repo dentro del repo y
# duplicaría todo en cada rama. Lo que hace un agente llega por su propia rama,
# no por esta carpeta, y git la borra sola cuando el agente termina.
.claude/worktrees/

# Recuerdos impresos: la foto es de compañeros menores de edad y el repo es
# público. Se queda en el teléfono y en la imprenta, no aquí. Lo mismo lo que
# sale con la foto puesta.
recuerdos/**/foto.jpg
recuerdos/**/salida/
